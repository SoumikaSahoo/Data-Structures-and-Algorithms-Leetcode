class Solution {
    public int longestSubarray(int[] nums) {
        int left=0;
       int countzero=0;
       int ans=0;
        for(int right=0;right<nums.length;right++){
            if(nums[right]==0){
                countzero++;
            }
            while(countzero>1){
                if(nums[left]==0){
                    countzero--;
                }
                left++;
            }
            int length=right-left+1;
            ans=Math.max(ans,length-1);

    }
    return ans;
    }
}
